@model List<PasionMidtermStore.Models.CartItem>

<h1>Cart</h1>

<table class="table table-bordered">
    <thead>
        <tr><th>Product Name</th><th>Price</th><th>Quantity</th></tr>
    </thead>
    <tbody>

    @foreach (var p in Model)
        {
            <tr>
                <td>@p.ProductName</td>                
                <td>@p.Price</td>
                <td>@p.Quantity</td>
            </tr>
        }
    </tbody>
</table>