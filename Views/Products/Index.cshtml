@model List<PasionMidtermStore.Models.Product>

@{ ViewData["Title"] = "Products"; }

<h1>Products</h1>

<a asp-action="Create" class="btn btn-primary mb-3">+ Add Product</a>

<div class="row">
    
    
        @foreach (var p in Model)
        {
           <div class="col-md-4 mb-4">
           <div class="card h-100">
           <div class="card-body">
                <h5 class="card-title">@p.Name</h5>
                <h5 class="card-title">@p.Description</h5>
                <h5 class="card-title">@p.Category</h5>
                <h5 class="card-title">₱@p.Price</h5>
                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-warning">Edit</a>
                <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-danger"onclick="return
                confirm('Delete this product?')">Delete</a>
                <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@p.Id" class="btn btn-sm
                btn-success">Add to Cart</a>
                
            </div>
            </div>
            </div> 
                
            
        }
</div>